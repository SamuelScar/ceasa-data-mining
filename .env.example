# Último dia do período de treino usado para inferir conversões.
# Formato: AAAA-MM-DD. Deixe vazio para apenas catalogar candidatas.
CEASA_DATA_LIMITE_INFERENCIA=2025-10-31

# Recorte temporal e cobertura mínima das séries usadas no teste de Granger.
GRANGER_DATA_INICIO=2022-01-04
GRANGER_DATA_CORTE_TREINO=2025-10-31
GRANGER_DATA_FIM_TESTE=2026-10-31
GRANGER_MIN_DIAS_COMUNS=400
GRANGER_FFILL_LIMITE=3
GRANGER_MAX_LAG=10
GRANGER_ALPHA=0.05

# Regra inicial para caracterizar a propagação de uma alta entre mercados.
DOMINO_ALTA_MINIMA=0.05
DOMINO_PERCENTIL=0.90
DOMINO_JANELA_DIAS=5

# Início das duas validações temporais da modelagem.
MODELAGEM_INICIO_VALIDACAO_1=2024-01-01
MODELAGEM_INICIO_VALIDACAO_2=2025-01-01
