# Parâmetros temporais usados somente pelos serviços individuais. Os pipelines
# versionados passam os cortes fixos de cada contexto diretamente aos scripts.
CEASA_DATA_CORTE_TREINO=2025-10-31

# Recorte temporal e cobertura mínima das séries usadas no teste de Granger.
GRANGER_DATA_INICIO=2022-01-04
GRANGER_DATA_CORTE_TREINO=2025-10-31
GRANGER_DATA_FIM_TESTE=2026-10-31
GRANGER_MIN_DIAS_COMUNS=400
GRANGER_FFILL_LIMITE=3
GRANGER_MAX_LAG=10
GRANGER_ALPHA=0.05

# Regra inicial para caracterizar a propagação de uma alta entre mercados.
DOMINO_ALTA_MINIMA=0.05
DOMINO_PERCENTIL=0.90
DOMINO_JANELA_DIAS=5

# Contexto exigido pelo serviço individual base-modelagem:
# validacao_1, validacao_2 ou final.
MODELAGEM_CONTEXTO=

# Reprodutibilidade da comparação e do ajuste dos modelos.
TREINAMENTO_SEMENTE=42

# Nome opcional da execução. Vazio gera automaticamente pela data e hora.
PIPELINE_VERSAO=

# A avaliação final exige o JSON congelado produzido pelo pipeline de
# desenvolvimento. O nome da execução final também é opcional.
PIPELINE_SELECAO_JSON=
PIPELINE_AVALIACAO_FINAL_VERSAO=
